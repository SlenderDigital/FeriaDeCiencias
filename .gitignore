# Tracker runtime status (regenerado al arrancar el tracker)
.tracker.status

# Godot 4+ specific ignores
.godot/
.nomedia

# Third-party addons (re-downloadable)
addons/godot_ai/

# User-specific export configuration
export_presets.cfg

# Python tracker server
tracker_server/.venv/
tracker_server/hand_landmarker.task
tracker_server/.tracker.pid
tracker_server/.tracker.status
tracker_server/.tracker.log
__pycache__/
*.pyc

# Hermes agent internal (no del projecto)

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# T9/T10: capturas de revisión visual y artefactos de captura (no son código).
# Escriben en /tmp/shot_*.png y en .jsab_ref/ — regenerables con tools/record_run.sh
.jsab_ref/
*.log

# El ledger de SDD SÍ se versiona; este patrón sólo cubre el scratch runtime.
.superpowers/*/scratch/

# .hermes/ SÍ se versiona (planes de trabajo). Antes ignorado: los planes
# se perdían con un reset de disco.
