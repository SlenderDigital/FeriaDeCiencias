[node name="InfoText" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.8, 0.9)
theme_override_font_sizes/font_size = 14
text = "ABSTRACT PULSE\nJuego rítmico de acción con estética modular synth.\n\n• Referente: Bautista Prieto\n• Evento: Feria de Ciencias 2026\n• Motor: Godot Engine 4.7\n• Control: MediaPipe Hand Tracking / Teclado + Mouse\n• Repositorio: https://github.com/SlenderDigital/FeriaDeCiencias.git"
autowrap_mode = 3
horizontal_alignment = 1

[node name="BtnClose" type="Button" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "CERRAR"

[connection signal="pressed" from="Panel/VBox/BtnClose" to="." method="hide_overlay"]