[gd_scene load_steps=3 format=3 uid="uid://settings_overlay_v1"]

[ext_resource type="Theme" path="res://resources/patchbay_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/SettingsOverlay.gd" id="2_script"]

[node name="SettingsOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
